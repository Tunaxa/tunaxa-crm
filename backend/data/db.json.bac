    {
      "id": "workflow_31ca7967-64ab-448f-9eae-8a7379247546",
      "name": "Follow-up on new lead",
      "enabled": true,
      "event": "lead.created",
      "filter": {
        "field": "status",
        "value": "Qualified"
      },
      "actions": [
        {
          "type": "task",
          "title": "Follow up with {{name}}",
          "owner": "Rayan",
          "priority": "High",
          "dueDate": ""
        },
        {
          "type": "email",
          "to": "{{email}}",
          "subject": "Welcome {{name}}",
          "body": "Hello {{name}} from {{company}}"
        }
      ],
      "createdAt": "2026-08-14T22:53:06.418Z",
      "updatedAt": "2026-08-26T09:10:40.883Z"
    },
    {
      "id": "workflow_e19ff50d-d170-422a-9e3c-5761f5607b56",
      "name": "New lead follow-up (Marketing playbook)",
      "description": "Automation playbook: when a lead is created, assign an owner and create a task to follow up next business day.",
      "event": "lead.created",
      "filter": {
        "field": "status",
        "op": "in",
        "value": [
          "New",
          "Nurture"
        ]
      },
      "nodes": [],
      "actions": [
        {
          "type": "task",
          "title": "Follow up on new lead {{name}}",
          "owner": "{{owner}}",
          "priority": "High",
          "dueDate": ""
        }
      ],
      "enabled": false,
      "createdAt": "2026-08-30T09:06:33.379Z",
      "createdBy": "System",
      "updatedAt": "2026-08-30T09:06:33.385Z"
    },
    {
      "id": "workflow_72bc389d-b560-4b64-9c47-9e4a9609d3ae",
      "name": "Welcome email to new contacts",
      "description": "Automation playbook: send a welcome email when a new contact is created.",
      "event": "contact.created",
      "filter": {
        "field": "email",
        "op": "isSet"
      },
      "nodes": [],
      "actions": [
        {
          "type": "email",
          "to": "{{email}}",
          "subject": "Welcome to Tunaxa",
          "body": "Hi {{name}},\n\nWelcome! We are glad to have you on board."
        }
      ],
      "enabled": false,
      "createdAt": "2026-08-30T09:06:33.385Z",
      "createdBy": "System",
      "updatedAt": "2026-08-30T09:06:33.385Z"
    },
    {
      "id": "workflow_64eee1b1-847b-44b4-a56a-a97de936b2fd",
      "name": "Risky deal alert",
      "description": "Automation playbook: create an urgent task when a deal slips back to negotiation without a close date.",
      "event": "deal.updated",
      "filter": {
        "field": "stage",
        "op": "in",
        "value": [
          "negotiation",
          "proposal"
        ]
      },
      "nodes": [],
      "actions": [
        {
          "type": "task",
          "title": "Review risky deal {{title}}",
          "owner": "{{owner}}",
          "priority": "Urgent",
          "dueDate": ""
        }
      ],
      "enabled": false,
      "createdAt": "2026-08-30T09:06:33.385Z",
      "createdBy": "System",
      "updatedAt": "2026-08-30T09:06:33.385Z"
    },
    {
      "id": "workflow_43fbfc88-f0c7-43ff-b130-12963a62f40a",
      "name": "Form submission auto-responder",
      "description": "Automation playbook: when a form is submitted, send an immediate acknowledgment email.",
      "event": "form.submitted",
      "filter": {
        "field": "email",
        "op": "isSet"
      },
      "nodes": [],
      "actions": [
        {
          "type": "email",
          "to": "{{email}}",
          "subject": "Thank you for your submission",
          "body": "Hi {{name}},\n\nThanks for getting in touch. We will get back to you shortly."
        }
      ],
      "enabled": false,
      "createdAt": "2026-08-30T09:06:33.385Z",
      "createdBy": "System",
      "updatedAt": "2026-08-30T09:06:33.385Z"
    },
    {
      "id": "workflow_2ce8b9b9-5a70-46da-aac1-e798fcaf4c39",
      "name": "Low-stock reorder reminder",
      "description": "Automation playbook: flag low-stock products to the inventory owner as a task.",
      "event": "product.updated",
      "filter": {
        "field": "stock",
        "op": "isSet"
      },
      "nodes": [],
      "actions": [
        {
          "type": "task",
          "title": "Reorder low-stock product {{name}}",
          "owner": "{{owner}}",
          "priority": "High",
          "dueDate": ""
        }
      ],
      "enabled": false,
      "createdAt": "2026-08-30T09:06:33.385Z",
      "createdBy": "System",
      "updatedAt": "2026-08-30T09:06:33.385Z"
    },
    {
      "id": "workflow_4bfbe1a8-2046-4554-8a83-93ec17c1f662",
      "name": "Invoice overdue reminder",
      "description": "Automation playbook: send an email reminder when an invoice becomes overdue.",
      "event": "invoice.created",
      "filter": {
        "field": "status",
        "op": "neq",
        "value": "paid"
      },
      "nodes": [],
      "actions": [
        {
          "type": "email",
          "to": "{{customerEmail}}",
          "subject": "Invoice reminder",
          "body": "Hi {{customerName}},\n\nJust a reminder about invoice {{number}} due {{dueDate}}."
        }
      ],
      "enabled": false,
      "createdAt": "2026-08-30T09:06:33.385Z",
      "createdBy": "System",
      "updatedAt": "2026-08-30T09:06:33.385Z"
    },
    {
