# =============================================================================
# Tunaxa CRM - example environment
#
# Copy to `.env` in the repository root and adjust:
#     cp .env.example .env
#
# Every value below is OPTIONAL. Each one falls back to the default shown here,
# so an empty `.env` boots fine for a default local setup.
#
# Precedence: real environment variables (shell export, CI secret) > `.env` >
# the defaults in backend/runtime.js.
#
# Note: the database variables use the standard libpq `PG*` names. `DATABASE_URL`
# and `DB_*` are NOT read by this project.
# =============================================================================

# ---------- PostgreSQL (optional) ----------
# Only needed for `npm run migrate`, `npm run migrate:data`, and the V1
# object API. The CRM itself stores workspace records in backend/data/db.json.
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=tunaxa
PGUSER=postgres
# Change this to the password of your local `postgres` role.
PGPASSWORD=tunaxa2024

# ---------- Redis (optional) ----------
# Leave unset to boot in reduced mode: no BullMQ webhook queue and no query
# cache. The rest of the app works normally.
#REDIS_URL=redis://127.0.0.1:6379
#REDIS_ENABLED=true

# ---------- Backend HTTP (optional) ----------
# Port the API binds. The Vite dev proxy derives its target from this.
#PORT=3001
# Interface the API binds. Loopback by default; use 0.0.0.0 in a container.
#HOST=127.0.0.1

# Absolute origin third parties use to reach the API: webhook target URLs and
# email tracking pixels. Set this when a reverse proxy exposes the API somewhere
# the backend process cannot see. Derived as http://$HOST:$PORT when unset.
#BASE_URL=https://crm.example.com

# Health probe used by the launcher in start.js. Derived from BASE_URL when unset.
#API_HEALTH_URL=http://127.0.0.1:3001/api/health

# ---------- Frontend ----------
# The Vite dev server port is fixed at 5173 by the `dev`/`start` npm scripts.

# ---------- Runtime (optional) ----------
# `production` marks the auth cookie Secure. Also switches Sentry environment.
#NODE_ENV=development

# ---------- Monitoring (optional) ----------
# Sentry DSN. Errors are not reported when unset.
#SENTRY_DSN=