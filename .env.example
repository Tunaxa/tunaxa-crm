# =============================================================================
# Tunaxa CRM - local development environment (template)
# =============================================================================
# Copy this file to `.env` and adjust for your machine:
#
#   cp .env.example .env
#
# Nothing loads this file automatically: pass it explicitly with
# `node --env-file=.env ...` (Node 20.6+), or rely on `docker compose` which
# reads `.env` in the repo root for variable substitution (see
# docker-compose.yml).
#
# Any value may be left at its default; the backend boots fine with the
# PostgreSQL and Redis services from `docker compose up -d`.
# =============================================================================

# -----------------------------------------------------------------------------
# PostgreSQL
# -----------------------------------------------------------------------------
# Consumed by backend/db/pg.js. These are the connection defaults; setting them
# here makes the connection deterministic instead of relying on hardcoded
# fallbacks. `docker compose up -d` provisions a postgres:16 container that
# matches these values (override in .env and Compose picks them up).
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=tunaxa
PGUSER=postgres
# Local-only default, also used as POSTGRES_PASSWORD by the Compose postgres
# service. Change it in production. If you change it after the postgres volume
# has been initialised, recreate the volume (`docker compose down -v`) or the
# database will keep the original password.
PGPASSWORD=tunaxa2024

# ---------- Alternate connection-string form (optional) ----------
# backend/db/pg.js currently resolves the connection from the PG* variables
# above; a full connection string is reserved for tooling/CI that prefers one.
# DATABASE_URL=postgres://postgres:tunaxa2024@127.0.0.1:5432/tunaxa

# -----------------------------------------------------------------------------
# Redis (webhook queue + cache)
# -----------------------------------------------------------------------------
# Consumed by backend/services/cache.js, services/webhookQueue.js and
# workers/webhookWorker.js. When REDIS_URL is set, queue/cache features are
# enabled and webhooks are processed from Redis. Leave both unset (or set
# REDIS_ENABLED=false) to run in reduced in-memory mode instead of failing.
# `docker compose up -d` publishes Redis on host port 6380 by default (bound to
# all interfaces; restrict it in docker-compose.yml if you need loopback-only).
REDIS_PORT=6380
REDIS_ENABLED=true
REDIS_URL=redis://127.0.0.1:6380

# Used by the queue/worker modules only when REDIS_URL is unset.
# REDIS_HOST=127.0.0.1

# When the backend itself runs inside the Compose network, point at the service
# name instead of localhost:
# REDIS_URL=redis://redis:6379

# -----------------------------------------------------------------------------
# Backend HTTP
# -----------------------------------------------------------------------------
# backend/server.js reads PORT (default 3001) and HOST (default 127.0.0.1).
# Set HOST=0.0.0.0 when the backend runs inside a container so the published
# port is reachable from outside it.
PORT=3001
HOST=127.0.0.1

# Health-check URL polled by start.js.
API_HEALTH_URL=http://127.0.0.1:3001/api/health

# Base URL used to build public webhook endpoints in
# backend/routes/webhookendpoints.js. Set this to your public tunnel/DNS in
# any environment where the CRM must receive inbound webhooks.
BASE_URL=http://127.0.0.1:3001

# Base URL used by background workers to build public links, including report
# emails in backend/workers/reportScheduler.js. Set both BASE_URL and
# PUBLIC_BASE_URL to your public tunnel/DNS when exposing the CRM.
PUBLIC_BASE_URL=http://127.0.0.1:3001

# -----------------------------------------------------------------------------
# Ollama (local LLM server)
# -----------------------------------------------------------------------------
# `docker compose up -d` runs ollama/ollama with persistent model storage.
# The backend does not read OLLAMA_HOST; its Ollama base URL comes from
# settings.ollamaBaseUrl (Settings -> AI, default http://localhost:11434).
# The Compose service sets the container's own OLLAMA_HOST=0.0.0.0:11434.
# OLLAMA_HOST is kept for host-side Ollama clients only.
OLLAMA_PORT=11434
# OLLAMA_HOST=http://127.0.0.1:11434

# -----------------------------------------------------------------------------
# Auth / tokens
# -----------------------------------------------------------------------------
# The backend's auth uses opaque session tokens persisted in the JSON store
# (backend/data/db.json); it does not mint JWTs. JWT_SECRET is still used by
# backend/services/quoteToken.js as the quote-signing secret, falling back to
# APP_SECRET and then a non-secret development default. Set a strong, unique
# value in production.
# JWT_SECRET=

# -----------------------------------------------------------------------------
# SMTP (outbound email)
# -----------------------------------------------------------------------------
# SMTP is configured in-app under Settings (smtp host/port, username, and the
# SES secret key stored in db.json via backend/services/smtp.js) rather than
# via environment variables. backend/services/health.js reads SMTP_HOST and
# SMTP_USER when reporting whether SMTP is configured; sending still uses the
# stored Settings. SMTP_PORT and SMTP_PASS are reserved and not consumed yet.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=

# -----------------------------------------------------------------------------
# IMAP email sync (optional)
# -----------------------------------------------------------------------------
# Consumed by backend/services/emailSync.js. Falls back to the values stored in
# the db.json settings when these are unset.
# IMAP_HOST=
# IMAP_USER=
# IMAP_PASS=
# IMAP_PORT=993
# IMAP_SECURE=true

# -----------------------------------------------------------------------------
# Sentry (optional)
# -----------------------------------------------------------------------------
# SENTRY_DSN is read by backend/server.js (server-side error tracking);
# VITE_SENTRY_DSN is read by the web frontend via import.meta.env in
# web/src/main.tsx (Vite exposes VITE_-prefixed vars to the browser bundle).
# SENTRY_DSN=
# VITE_SENTRY_DSN=

# -----------------------------------------------------------------------------
# Runtime
# -----------------------------------------------------------------------------
# Read by backend/server.js (Sentry environment label) and other modules that
# gate behavior on production.
NODE_ENV=development
